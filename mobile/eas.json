{
  "cli": { "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_BASE_URL": "https://aws.bawebtech.com" }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "node": "22.21.1",
      "ios": { "buildConfiguration": "Release" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://aws.bawebtech.com",
        "EXPO_PUBLIC_VIEWER_BUILD_KIND": "internal-preview",
        "EXPO_PUBLIC_VIEWER_DIAGNOSTICS": "1"
      }
    },
    "simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    }
  }
}
